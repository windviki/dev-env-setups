# =============================================================================
# Dockerfile generated by dev-env-setups v1.0.0
# Generated at: 2026-07-17 06:35:27
# Modules: base docker uv nvm rustup gvm sdkman rbenv phpbrew luaenv rig sqlite3 perl code-server chsrc xcmd
# Base Image: ubuntu:22.04
# China Mirror: true
# =============================================================================

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Shanghai

RUN set -eux; \
    apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends \
        ca-certificates curl wget git vim \
        zip unzip build-essential gcc make cmake \
        net-tools iputils-ping telnet \
        pkg-config autoconf automake g++ \
        libssl-dev libexpat1-dev libpcre3-dev \
        libcap-dev bison flex bsdmainutils \
        iproute2 sudo && \
    rm -rf /var/lib/apt/lists/*

# Copy the setup scripts into the image
COPY . /opt/dev-env-setups
WORKDIR /opt/dev-env-setups


# ---------- China Mirror Environment Variables ----------
ENV MIRROR_FOR_GITHUB=https://ghfast.top \
    MIRROR_APT_SOURCE=mirrors.ustc.edu.cn \
    MIRROR_DOCKER=Aliyun \
    MIRROR_PYPI_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple \
    MIRROR_NPM_REGISTRY=https://registry.npmmirror.com \
    MIRROR_NODE=https://npmmirror.com/mirrors/node \
    MIRROR_RUSTUP_DIST=https://mirrors.tuna.tsinghua.edu.cn/rustup \
    MIRROR_RUSTUP_UPDATE=https://mirrors.tuna.tsinghua.edu.cn/rustup/rustup \
    MIRROR_CARGO_REGISTRY=rsproxy \
    MIRROR_GO_PROXY=https://goproxy.cn,direct \
    MIRROR_GO_BINARY=https://mirrors.aliyun.com/golang/ \
    MIRROR_RUBY_BUILD=https://mirrors.aliyun.com/ruby \
    MIRROR_RUBYGEMS_SOURCE=https://gems.ruby-china.com \
    MIRROR_PHP_SOURCE=https://mirrors.aliyun.com/php-src

# ---------- Version Pinning ----------
ENV CODE_SERVER_VERSION=4.128.0

# ---------- Install Modules ----------
RUN bash setup.sh --cn --only "base,docker,uv,nvm,rustup,gvm,sdkman,rbenv,phpbrew,luaenv,rig,sqlite3,perl,code-server,chsrc,xcmd"

# ---------- Environment Setup ----------
ENV PATH="/root/.local/bin:/root/.nvm/versions/node/$(node --version 2>/dev/null || echo v22)/bin:/root/.cargo/bin:/root/.gvm/gos/go1.24.13/bin:/root/.sdkman/candidates/java/current/bin:/root/.rbenv/shims:/root/.rbenv/bin:/root/.phpbrew/bin:$PATH"

# ---------- User Setup ----------
RUN useradd -m -s /bin/bash -u 1000 devuser && \
    echo "devuser ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/devuser && \
    chmod -R a+rX /root/.nvm /root/.local /root/.cargo /root/.gvm /root/.sdkman /root/.rustup /root/.rbenv /root/.luaenv 2>/dev/null || true && \
    chmod 755 /root

# ---------- Cleanup ----------
RUN rm -rf /var/lib/apt/lists/* /tmp/*

USER devuser
WORKDIR /workspace
CMD ["/bin/bash"]
